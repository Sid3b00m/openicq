# OpenICQ server configuration. Copy to /etc/openicq/openicq.env.
# Every one of these has a matching --flag; see `node server/index.js --help`.

# Listen on loopback only: the reverse proxy in front terminates TLS and is the
# only thing that should reach the server directly.
HOST=127.0.0.1
PORT=5190

OPENICQ_DATA=/var/lib/openicq/openicq.json

# Browser origins allowed to open a WebSocket. Set this to your real public
# URL. Without it, any website can drive this server with a visitor's browser.
OPENICQ_ORIGINS=https://icq.example.com

# Believe X-Forwarded-For only from the proxy on this machine, so the per-IP
# limits see real client addresses instead of 127.0.0.1. Never set this to
# "all" unless nothing but a proxy can reach the port.
OPENICQ_TRUST_PROXY=loopback

# Tell browsers to stick to HTTPS. Only switch this on once TLS works.
OPENICQ_HSTS=on

# Message on the sign-on screen.
OPENICQ_MOTD=Welcome back to 1999.

# Abuse limits. Raise them if real users share an address behind NAT.
OPENICQ_MAX_CONNECTIONS_PER_IP=12
OPENICQ_REGISTRATIONS_PER_HOUR=5

# Set to "off" once everyone you want has a UIN.
# OPENICQ_REGISTRATION=off

# Let /health report user and session counts. Off by default so a public
# endpoint does not advertise how many accounts exist.
# OPENICQ_HEALTH_DETAILS=on

# Once a day the server asks GitHub whether a newer release exists, and logs it
# if so. It sends only your version number and downloads nothing. Set to "off"
# to stop contacting GitHub at all.
# OPENICQ_UPDATE_CHECK=off

# Also show "update available" on the sign-on screen, to everyone rather than
# only in the log.
# OPENICQ_ANNOUNCE_UPDATES=on
